{
  "lexicon": 1,
  "id": "place.quintal.canto.blogroll",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["items", "updatedAt"],
        "properties": {
          "items": {
            "type": "array",
            "maxLength": 150,
            "items": {
              "type": "object",
              "required": ["did"],
              "properties": {
                "did": { "type": "string", "format": "did" },
                "note": { "type": "string", "maxGraphemes": 280 }
              }
            }
          },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
