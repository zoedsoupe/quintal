{
  "lexicon": 1,
  "id": "place.quintal.richtext.facet",
  "defs": {
    "main": {
      "type": "object",
      "required": ["index", "features"],
      "properties": {
        "index": { "type": "ref", "ref": "#byteSlice" },
        "features": {
          "type": "array",
          "items": {
            "type": "union",
            "refs": ["#bold", "#italic", "#strike", "#code"]
          }
        }
      }
    },
    "byteSlice": {
      "type": "object",
      "required": ["byteStart", "byteEnd"],
      "properties": {
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 0 }
      }
    },
    "bold": {
      "type": "object",
      "description": "Trecho em negrito (`**` ou `__` na fonte markdown).",
      "required": [],
      "properties": {}
    },
    "italic": {
      "type": "object",
      "description": "Trecho em itálico (`*` ou `_` na fonte markdown).",
      "required": [],
      "properties": {}
    },
    "strike": {
      "type": "object",
      "description": "Trecho riscado (`~~` na fonte markdown).",
      "required": [],
      "properties": {}
    },
    "code": {
      "type": "object",
      "description": "Trecho de código inline (crases na fonte markdown).",
      "required": [],
      "properties": {}
    }
  }
}
